#!/bin/sh

set -eu

remote_name=${1:-unknown}
remote_url=${2:-}
zero_sha=0000000000000000000000000000000000000000

lower_url=$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')
lower_url=${lower_url%/}

is_official_upstream_url()
{
    case "$lower_url" in
        https://github.com/xmrig/xmrig|\
        https://github.com/xmrig/xmrig.git|\
        http://github.com/xmrig/xmrig|\
        http://github.com/xmrig/xmrig.git|\
        git://github.com/xmrig/xmrig|\
        git://github.com/xmrig/xmrig.git|\
        git@github.com:xmrig/xmrig|\
        git@github.com:xmrig/xmrig.git|\
        ssh://git@github.com/xmrig/xmrig|\
        ssh://git@github.com/xmrig/xmrig.git|\
        *github.com/xmrig/xmrig|\
        *github.com/xmrig/xmrig.git|\
        *github.com/xmrig/xmrig/|\
        *github.com/xmrig/xmrig.git\?*|\
        *ssh.github.com:443/xmrig/xmrig|\
        *ssh.github.com:443/xmrig/xmrig.git)
            return 0
            ;;
    esac

    return 1
}

is_trusted_origin_url()
{
    case "$lower_url" in
        git@github-salvium:mysalvium/xmrig_salvium|\
        git@github-salvium:mysalvium/xmrig_salvium.git|\
        ssh://git@github-salvium/mysalvium/xmrig_salvium|\
        ssh://git@github-salvium/mysalvium/xmrig_salvium.git)
            return 0
            ;;
    esac

    return 1
}

is_donation_bearing_commit()
{
    commit=$1

    if git cat-file -e "$commit:docs/DONATION_LAYER.md" 2>/dev/null; then
        return 0
    fi

    for donation_ref in refs/heads/donation refs/remotes/origin/donation; do
        if git show-ref --verify --quiet "$donation_ref" &&
           git merge-base --is-ancestor "$donation_ref" "$commit"; then
            return 0
        fi
    done

    return 1
}

contains_legacy_personal_identity()
{
    local_sha=$1
    remote_sha=$2

    if [ "$remote_sha" = "$zero_sha" ] ||
       ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        revision_range=$local_sha
    else
        revision_range=$remote_sha..$local_sha
    fi

    for commit in $(git rev-list "$revision_range"); do
        identity=$(git show -s --format='%an <%ae>%n%cn <%ce>' "$commit" |
            tr '[:upper:]' '[:lower:]')
        case "$identity" in
            *trevorwilf*|*trevor\ wilford*|*trevor@nerdline.com*)
                return 0
                ;;
        esac
    done

    return 1
}

if [ "$remote_name" = "upstream" ] || is_official_upstream_url; then
    cat >&2 <<EOF
REJECTED: direct pushes to xmrig/xmrig are disabled in this repository.
Remote: $remote_name
URL:    $remote_url

Fetch from upstream is allowed. Any explicitly authorized upstream
contribution must use a clean upstream-based topic branch, pass
scripts/check-upstream-pr.sh, receive explicit user confirmation, and be
published through a reviewed fork PR rather than a direct push.
EOF
    exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero_sha" ]; then
        continue
    fi

    if contains_legacy_personal_identity "$local_sha" "$remote_sha"; then
        cat >&2 <<EOF
REJECTED: this push contains legacy personal commit identity metadata.
Local ref:  $local_ref
Remote ref: $remote_ref

Recreate the intended change on a clean mysalvium branch instead of pushing
the legacy history.
EOF
        exit 1
    fi

    if ! is_trusted_origin_url && is_donation_bearing_commit "$local_sha"; then
        cat >&2 <<EOF
REJECTED: a donation-bearing ref may only be pushed to the trusted repository.
Local ref:  $local_ref
Remote ref: $remote_ref
Remote:     $remote_name
URL:        $remote_url

Trusted destination:
git@github-salvium:mysalvium/xmrig_salvium.git
EOF
        exit 1
    fi
done

exit 0
